{
  "expo": {
    "name": "SST TRACK",
    "slug": "inspecciones-sst",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.oinac.inspeccionessst",
      "buildNumber": "1",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071421",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.oinac.inspeccionessst",
      "versionCode": 11
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "SST TRACK",
      "shortName": "SST TRACK",
      "themeColor": "#071421",
      "backgroundColor": "#071421"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "La app usa la cámara para tomar fotos de evidencia de las inspecciones.",
          "photosPermission": "La app usa tus fotos para adjuntar evidencia a las inspecciones.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "inspeccionessst",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "oskla"
  }
}
