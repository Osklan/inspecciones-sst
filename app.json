{
  "expo": {
    "name": "SST TRACK",
    "slug": "inspecciones-sst",
    "version": "0.6.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071421",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.oinac.inspeccionessst",
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "La app usa la cámara para tomar fotos de evidencia de las inspecciones.",
          "photosPermission": "La app usa tus fotos para adjuntar evidencia a las inspecciones.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "inspeccionessst",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "oskla"
  }
}
